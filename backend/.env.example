# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
PORT=3333
ORIGENS_PERMITIDAS=

# URL pública desta API. Registrada na Evolution ao criar a instância, para
# ela saber onde entregar os webhooks de status.
APP_URL_PUBLICA=

# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Única chave usada: a anon key existia para o frontend autenticar, e o login
# agora é próprio. Ignora RLS — só API e worker. NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=
# ---------------------------------------------------------------------------
# Sessão
#
# Segredo com que ESTA API assina os tokens de login. Nada a ver com o Supabase:
# a autenticação é própria. Trocar este valor derruba todas as sessões abertas.
# Gere com: openssl rand -hex 32
# ---------------------------------------------------------------------------
JWT_SECRET=
# Validade do token em horas. Sem refresh token: expirou, faz login de novo.
SESSAO_HORAS=12

# Conexão de SESSÃO (porta 5432), não o Transaction pooler (6543): o pg-boss
# usa LISTEN/NOTIFY e advisory locks, que o modo transaction não repassa.
# Errar isto derruba a API no boot, com a mensagem apontando para cá.
#
# Servem a conexão direta e o Session pooler, ambos em 5432. Na prática o
# Session pooler costuma ser a única opção: db.<ref>.supabase.co só publica
# registro AAAA, e rede sem rota IPv6 nunca alcança a porta — o sintoma é
# connect ETIMEDOUT num endereço 2600:..., não erro de senha. Copie a string
# em Connect > Session pooler (o usuário lá é postgres.<ref>, não postgres).
DATABASE_URL=

# Só desenvolvimento. Deixa a API subir sem fila: campanhas são criadas mas
# nenhuma sai, e as rotas de disparo respondem 503. Nunca em produção.
FILA_OPCIONAL=false

# ---------------------------------------------------------------------------
# Administrador inicial
#
# Não existe auto-cadastro: a API garante este admin no boot, e é por ele que
# todos os outros acessos são criados na tela de Usuários e acessos.
#
# Criado UMA vez. Se a conta já existir, a senha daqui é ignorada — trocar a
# senha pela tela não é desfeito no próximo restart.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
# Mínimo de 6 caracteres. Preencher junto com ADMIN_EMAIL, ou a API não sobe.
ADMIN_SENHA=
ADMIN_NOME=Administrador

# ---------------------------------------------------------------------------
# Evolution API (self-hosted, Docker/VPS)
#
# Sem isso o sistema não finge que enviou: cada mensagem falha com o motivo,
# e o Dashboard avisa em vermelho.
# ---------------------------------------------------------------------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Segredo compartilhado validado em POST /webhooks/evolution.
# O endpoint é público por natureza (a Evolution precisa alcançá-lo pela
# internet); sem isto qualquer um forjaria status de entrega ou opt-out.
# Gere com: openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Geração de variações — Groq (opcional)
#
# Usada só pelo botão "Gerar 5 variações" na tela de variações: reescreve a
# Opção 1 nas outras, mantendo o mesmo sentido. Sem a chave o botão responde
# 503 com o motivo, e escrever as opções à mão continua funcionando igual.
#
# A chave sai de https://console.groq.com/keys e começa com "gsk_".
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# Modelo usado na reescrita. Em branco, vale llama-3.3-70b-versatile.
#
# Fica configurável porque o catálogo da Groq muda rápido: modelo desativado
# vira uma linha trocada aqui, não um deploy. A lista atual está em
# https://console.groq.com/docs/models — precisa ser um modelo de chat que
# aceite `response_format: json_object`.
GROQ_MODELO=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# WhatsApp Business API oficial (opcional)
# Só templates aprovados, com tarifa por conversa iniciada.
# ---------------------------------------------------------------------------
META_WHATSAPP_TOKEN=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v21.0

# Envios simultâneos por canal. Subir demais é convite a bloqueio.
DISPARO_CONCORRENCIA_POR_CANAL=1
