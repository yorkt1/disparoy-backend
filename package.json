{
  "name": "disparoy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST, worker de disparo e webhook da Evolution do Disparoy",
  "workspaces": [
    "shared",
    "backend"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @disparoy/backend",
    "dev:worker": "npm run dev:worker -w @disparoy/backend",
    "build": "npm run build -w @disparoy/dominio && npm run build -w @disparoy/backend",
    "start:api": "npm run start -w @disparoy/backend",
    "start:worker": "npm run start:worker -w @disparoy/backend",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "compartilhado:gravar": "node scripts/hash-compartilhado.mjs --gravar",
    "compartilhado:verificar": "node scripts/hash-compartilhado.mjs --verificar"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  }
}
